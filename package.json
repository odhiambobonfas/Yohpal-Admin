{
    "name": "myexpress",
    "version": "1.0.0",
    "main": "server.js",
    "scripts": {
        "test": "jest",
        "dev": "pm2 start server.js --watch --ignore-watch='ejs node_modules public resources' --watch-delay 500",
        "start": "node --trace-deprecation server.js",
        "build": "webpack --config webpack.config.js",
        "build:dev": "webpack --mode development",
        "build:prod": "webpack --mode production",
        "postinstall": "patch-package"
    },
    "keywords": [
        "web boilerplate",
        "javascript",
        "myexpress",
        "framework",
        "MVC",
        "web"
    ],
    "author": {
        "name": "Giceha Junior",
        "email": "gicehajunior76@daphascomp.com",
        "url": "https://github.com/Gicehajunior"
    },
    "repository": "https://github.com/Gicehajunior/myexpress-framework",
    "license": "MIT",
    "description": "",
    "_moduleAliases": {
        "@mex": "./mex",
        "@app": "./app",
        "@config": "./config",
        "@lang": "./public/default/js/lang",
        "@service": "./public/store/services",
        "@models": "./app/models",
        "@utils": "./app/utils",
        "@db": "./config/database",
        "@database": "./config/database",
        "@services": "./mex/services",
        "@controllers": "./app/controllers",
        "@routes": "./routes"
    },
    "jest": {
        "testEnvironment": "node",
        "moduleNameMapper": {
            "^@mex/(.*)$": "<rootDir>/mex/$1",
            "^@mex$": "<rootDir>/mex",

            "^@app/(.*)$": "<rootDir>/app/$1",
            "^@app$": "<rootDir>/app",

            "^@config/(.*)$": "<rootDir>/config/$1",
            "^@config$": "<rootDir>/config",

            "^@lang/(.*)$": "<rootDir>/public/default/js/lang/$1",
            "^@lang$": "<rootDir>/public/default/js/lang",

            "^@service/(.*)$": "<rootDir>/public/store/services/$1",
            "^@service$": "<rootDir>/public/store/services",

            "^@models/(.*)$": "<rootDir>/app/models/$1",
            "^@models$": "<rootDir>/app/models",

            "^@utils/(.*)$": "<rootDir>/app/utils/$1",
            "^@utils$": "<rootDir>/app/utils",

            "^@db/(.*)$": "<rootDir>/config/database/$1",
            "^@db$": "<rootDir>/config/database",

            "^@database/(.*)$": "<rootDir>/config/database/$1",
            "^@database$": "<rootDir>/config/database",

            "^@services/(.*)$": "<rootDir>/mex/services/$1",
            "^@services$": "<rootDir>/mex/services",

            "^@controllers/(.*)$": "<rootDir>/app/controllers/$1",
            "^@controllers$": "<rootDir>/app/controllers",

            "^@routes/(.*)$": "<rootDir>/routes/$1",
            "^@routes$": "<rootDir>/routes"
        },
        "moduleFileExtensions": ["js", "json", "ts", "node"]
    },
    "dependencies": {
        "@fortawesome/fontawesome-free": "^6.7.2",
        "@google-cloud/firestore": "^7.11.3",
        "@google-cloud/storage": "^7.17.0",
        "@popperjs/core": "^2.11.8",
        "@sendgrid/mail": "^8.1.5",
        "bcryptjs": "^3.0.2",
        "bootstrap": "^5.3.3",
        "bootstrap-datepicker": "^1.10.0",
        "chart.js": "^4.4.8",
        "connect-flash": "^0.1.1",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "crypto-js": "^4.2.0",
        "datatables": "^1.10.18",
        "dotenv": "^16.4.7",
        "ejs": "^3.1.10",
        "express": "^4.21.2",
        "express-ejs-layouts": "^2.5.1",
        "express-handlebars": "^8.0.1",
        "express-session": "^1.18.1",
        "express-validator": "^7.2.1",
        "firebase": "^11.4.0",
        "firebase-admin": "^13.2.0",
        "fs-extra": "^11.3.0",
        "gulp": "^4.0.2",
        "gulp-javascript-obfuscator": "^1.1.6",
        "gulp-sourcemaps": "^3.0.0",
        "helmet": "^8.0.0",
        "jquery": "^3.7.1",
        "jsonwebtoken": "^9.0.2",
        "minimist": "^1.2.8",
        "module-alias": "^2.2.3",
        "moment": "^2.30.1",
        "morgan": "^1.10.0",
        "multer": "^1.4.5-lts.1",
        "mysql2": "^3.13.0",
        "patch-package": "^8.0.0",
        "pm2": "^6.0.11",
        "popper.js": "^1.16.1",
        "postinstall-postinstall": "^2.1.0",
        "print-js": "^1.6.0",
        "pug": "^3.0.3",
        "redi": "^0.1.0",
        "redis": "^4.7.0",
        "select2": "^4.1.0-rc.0",
        "sequelize": "^6.37.6",
        "swagger-jsdoc": "^6.2.8",
        "swagger-ui-dist": "^5.20.8",
        "swagger-ui-express": "^5.0.1",
        "sweetalert2": "^11.17.2",
        "toastr": "^2.1.4",
        "unirest": "^0.6.0",
        "uuid": "^11.1.0",
        "vinyl-sourcemaps-apply": "^0.2.1",
        "winston": "^3.17.0"
    },
    "devDependencies": {
        "@babel/cli": "^7.26.4",
        "@babel/core": "^7.26.10",
        "@babel/preset-env": "^7.26.9",
        "@babel/register": "^7.25.9",
        "babel-loader": "^10.0.0",
        "copy-webpack-plugin": "^13.0.0",
        "jest": "^29.7.0",
        "nodemon": "^3.1.9",
        "supertest": "^7.0.0",
        "webpack": "^5.98.0",
        "webpack-cli": "^6.0.1"
    }
}
