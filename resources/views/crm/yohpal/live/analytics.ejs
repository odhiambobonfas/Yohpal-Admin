<%- include('crm/partials/header') %>
    <%- include('crm/partials/navbar') %>

        <div class="container-fluid gx-0 px-0">
            <div class="row gap-0 gx-0">
                <div class="col-md-3"><%- include('crm/partials/sidebar') %></div>
                <div class="col-md-9 mt-2 content-body">
                    <%- include('crm/partials/topbar') %>

                        <div class="container-fluid m-0 p-0 pb-5">
                            <div class="d-flex align-items-center m-1 mt-3 px-3">
                                <h4 class="mb-0 text-dark fw-bold">Streaming Insights</h4>
                                <span class="ms-3 badge bg-light text-muted border">Last 500 Sessions</span>
                            </div>

                            <!-- Standard Stats Row -->
                            <div class="row m-1 mt-3 g-3">
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div
                                        class="text-start p-4 shadow-sm bg-white rounded border-top border-primary border-3">
                                        <h5 class="stat-count" id="stat-total-airtime">0m</h5>
                                        <p class="mb-0 text-muted small uppercase fw-bold">Total Airtime</p>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div
                                        class="text-start p-4 shadow-sm bg-white rounded border-top border-success border-3">
                                        <h5 class="stat-count" id="stat-avg-length">0m</h5>
                                        <p class="mb-0 text-muted small uppercase fw-bold">Avg. Stream Length</p>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div
                                        class="text-start p-4 shadow-sm bg-white rounded border-top border-warning border-3">
                                        <h5 class="stat-count" id="stat-avg-attendees">0</h5>
                                        <p class="mb-0 text-muted small uppercase fw-bold">Avg. Attendees</p>
                                    </div>
                                </div>
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div
                                        class="text-start p-4 shadow-sm bg-white rounded border-top border-info border-3">
                                        <h5 class="stat-count" id="stat-total-sessions">0</h5>
                                        <p class="mb-0 text-muted small uppercase fw-bold">Total Sessions</p>
                                    </div>
                                </div>
                            </div>

                            <!-- Featured Analytics Cards -->
                            <div class="row m-1 mt-4 g-3">
                                <!-- Most Active Host -->
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="analytics-card analytics-card-crown h-100">
                                        <div class="analytics-card-icon">
                                            <i class="fas fa-crown"></i>
                                        </div>
                                        <div class="analytics-card-body" id="container-top-streamer">
                                            <div class="spinner-border spinner-border-sm text-muted" role="status"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Peak Session -->
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="analytics-card analytics-card-chart h-100">
                                        <div class="analytics-card-icon">
                                            <i class="fas fa-chart-line"></i>
                                        </div>
                                        <div class="analytics-card-body" id="container-peak-session">
                                            <div class="spinner-border spinner-border-sm text-muted" role="status"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Recently Live -->
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="analytics-card analytics-card-clock h-100">
                                        <div class="analytics-card-icon">
                                            <i class="fas fa-clock"></i>
                                        </div>
                                        <div class="analytics-card-body" id="container-latest-stream">
                                            <div class="spinner-border spinner-border-sm text-muted" role="status"></div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Active Now -->
                                <div class="col-12 col-md-6 col-lg-3">
                                    <div class="analytics-card analytics-card-live h-100">
                                        <div class="analytics-card-icon">
                                            <i class="fas fa-video"></i>
                                        </div>
                                        <div class="analytics-card-body" id="container-active-now">
                                            <div class="spinner-border spinner-border-sm text-muted" role="status"></div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                </div>
            </div>
        </div>

        <style>
            .stat-count {
                font-size: 1.75rem;
                font-weight: 700;
                margin-bottom: 0.25rem;
                color: #333;
            }

            /* Analytics Cards */
            .analytics-card {
                position: relative;
                background: white;
                border-radius: 16px;
                padding: 24px;
                box-shadow: 0 2px 8px rgba(0,0,0,0.08);
                overflow: hidden;
                transition: all 0.3s ease;
            }

            .analytics-card:hover {
                transform: translateY(-4px);
                box-shadow: 0 8px 16px rgba(0,0,0,0.12);
            }

            .analytics-card-icon {
                position: absolute;
                top: 20px;
                right: 20px;
                width: 48px;
                height: 48px;
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                opacity: 0.2;
            }

            .analytics-card-crown .analytics-card-icon {
                background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
                color: white;
            }

            .analytics-card-chart .analytics-card-icon {
                background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
                color: white;
            }

            .analytics-card-clock .analytics-card-icon {
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                color: white;
            }

            .analytics-card-live .analytics-card-icon {
                background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
                color: white;
            }

            .analytics-card-body {
                position: relative;
                z-index: 1;
            }

            .analytics-card-title {
                font-size: 13px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: #6b7280;
                margin-bottom: 12px;
            }

            .analytics-card-main {
                margin-bottom: 16px;
            }

            .analytics-card-avatar {
                width: 64px;
                height: 64px;
                border-radius: 50%;
                object-fit: cover;
                border: 3px solid #f3f4f6;
                margin-bottom: 12px;
            }

            .analytics-card-username {
                font-size: 18px;
                font-weight: 700;
                color: #111827;
                margin-bottom: 4px;
                line-height: 1.3;
            }

            .analytics-card-metric {
                font-size: 40px;
                font-weight: 800;
                line-height: 1;
                margin-bottom: 8px;
            }

            .analytics-card-crown .analytics-card-metric {
                background: linear-gradient(135deg, #f59e0b 0%, #d97706 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

            .analytics-card-chart .analytics-card-metric {
                background: linear-gradient(135deg, #3b82f6 0%, #2563eb 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

            .analytics-card-clock .analytics-card-metric {
                background: linear-gradient(135deg, #10b981 0%, #059669 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

            .analytics-card-live .analytics-card-metric {
                background: linear-gradient(135deg, #ef4444 0%, #dc2626 100%);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
                background-clip: text;
            }

            .analytics-card-label {
                font-size: 13px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.5px;
                color: #9ca3af;
            }

            .analytics-card-stats {
                display: flex;
                gap: 16px;
                padding-top: 12px;
                border-top: 1px solid #f3f4f6;
            }

            .analytics-card-stat {
                flex: 1;
            }

            .analytics-card-stat-value {
                font-size: 20px;
                font-weight: 700;
                color: #111827;
                line-height: 1.2;
            }

            .analytics-card-stat-label {
                font-size: 12px;
                color: #9ca3af;
                font-weight: 500;
                text-transform: uppercase;
                letter-spacing: 0.3px;
                margin-top: 2px;
            }

            .analytics-badge {
                display: inline-flex;
                align-items: center;
                gap: 6px;
                padding: 6px 14px;
                border-radius: 20px;
                font-size: 13px;
                font-weight: 600;
            }

            .analytics-badge-live {
                background: #fef2f2;
                color: #dc2626;
            }

            .analytics-badge-ended {
                background: #f3f4f6;
                color: #6b7280;
            }

            .analytics-badge-live::before {
                content: '';
                width: 7px;
                height: 7px;
                border-radius: 50%;
                background: #dc2626;
                animation: pulse 2s infinite;
            }

            @keyframes pulse {
                0%, 100% { opacity: 1; }
                50% { opacity: 0.5; }
            }

            .analytics-card-subtitle {
                font-size: 14px;
                color: #6b7280;
                margin-top: 4px;
            }
        </style>

        <%- include('crm/partials/footer') %>

            <script type="text/javascript" src="/default/js/src/mod/live.js"></script>
            <script>
                $(document).ready(function () {
                    if (typeof LiveMod !== 'undefined' && LiveMod.initAnalytics) {
                        LiveMod.initAnalytics();
                    }
                });
            </script>

            <%- include('crm/partials/closure') %>