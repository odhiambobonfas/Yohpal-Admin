<%- include('crm/partials/header') %>
    <%- include('crm/partials/navbar') %>

        <div class="container-fluid gx-0 px-0">
            <div class="row gap-0 gx-0">
                <div class="col-md-3"><%- include('crm/partials/sidebar') %></div>
                <div class="col-md-9 mt-2 content-body">
                    <div
                        class="shadow-lg bg-light-gray p-2 text-dark d-flex justify-content-between align-items-center mb-3">
                        <h4>Video Management</h4>
                    </div>

                    <div class="content-body gx-0 px-0 h-100">
                        <!-- Filter Tabs -->
                        <div class="card-header bg-white shadow-sm p-2 mb-3">
                            <div class="row g-3 align-items-end">
                                <!-- Filter buttons with icons for better UX -->
                                <div class="col-md-7">
                                    <div class="btn-group" role="group">
                                        <button type="button" class="btn btn-outline-primary filter-btn active"
                                            data-filter="all">
                                            <i class="fas fa-video"></i> All Videos
                                        </button>
                                        <div class="btn-group" role="group">
                                            <button type="button" class="btn btn-outline-warning dropdown-toggle"
                                                data-bs-toggle="dropdown" aria-expanded="false">
                                                <i class="fas fa-exclamation-triangle"></i> Reported
                                            </button>
                                            <ul class="dropdown-menu">
                                                <li><a class="dropdown-item filter-btn" href="#"
                                                        data-filter="reported_videos">Reported Videos</a></li>
                                                <li><a class="dropdown-item filter-btn" href="#"
                                                        data-filter="reported_creators">Reported Creators</a></li>
                                                <li><a class="dropdown-item filter-btn" href="#"
                                                        data-filter="reported_reporters">Report Submissions</a></li>
                                            </ul>
                                        </div>
                                        <button type="button" class="btn btn-outline-danger filter-btn"
                                            data-filter="true">
                                            <i class="fas fa-flag"></i> Flagged
                                        </button>
                                        <button type="button" class="btn btn-outline-secondary filter-btn"
                                            data-filter="blocked">
                                            <i class="fas fa-ban"></i> Blocked Users
                                        </button>
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <input type="text" class="form-control" id="searchUploader"
                                        placeholder="Search by username">
                                </div>
                            </div>
                        </div>

                        <!-- Cards Container -->
                        <div class="container-fluid col-12 p-0">
                            <div id="videos" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3"
                                style="display:none;">
                                <!-- Cards loaded here -->
                            </div>
                            <div id="loading" class="text-center py-4">
                                <div class="spinner-border" role="status"></div>
                            </div>
                            <div id="empty-state" class="text-center py-5" style="display:none;">
                                <i class="fas fa-video fa-3x text-muted mb-3"></i>
                                <h5>No videos found</h5>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Flag Modal -->
        <div class="modal fade" id="flagModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Flag Video</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="flagVideoId">
                        <div class="mb-3">
                            <label for="flagReason" class="form-label">Reason for flagging <span
                                    class="text-danger">*</span></label>
                            <textarea class="form-control" id="flagReason" rows="3"
                                placeholder="Enter reason for flagging this video..." required></textarea>
                            <div class="invalid-feedback">
                                Please provide a reason for flagging this video.
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-danger" id="confirmFlag">Flag Video</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Block User Modal -->
        <div class="modal fade" id="blockUserModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-warning">
                        <h5 class="modal-title"><i class="fas fa-ban"></i> Block User Account</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="blockUserId">
                        <div class="alert alert-warning">
                            <i class="fas fa-exclamation-triangle"></i>
                            <strong>Warning:</strong> This will suspend the user's account and prevent them from
                            uploading new content.
                        </div>
                        <div class="mb-3">
                            <label for="blockReason" class="form-label">Reason for blocking <span
                                    class="text-danger">*</span></label>
                            <textarea class="form-control" id="blockReason" rows="3"
                                placeholder="Enter reason for blocking this user..."
                                required>Account under review</textarea>
                            <div class="invalid-feedback">
                                Please provide a reason for blocking this user.
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-warning" id="confirmBlockUser">
                            <i class="fas fa-ban"></i> Block User
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Unblock User Modal -->
        <div class="modal fade" id="unblockUserModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-success text-white">
                        <h5 class="modal-title"><i class="fas fa-unlock"></i> Unblock User Account</h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" id="unblockUserId">
                        <div class="alert alert-info">
                            <i class="fas fa-info-circle"></i>
                            This will reactivate the user's account and allow them to upload content again.
                        </div>
                        <p>Are you sure you want to unblock this user?</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                        <button type="button" class="btn btn-success" id="confirmUnblockUser">
                            <i class="fas fa-unlock"></i> Unblock User
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- View All Reports Modal -->
        <div class="modal fade" id="viewReportsModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header bg-info text-white">
                        <h5 class="modal-title">
                            <i class="fas fa-list"></i> All Reports for this Video
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="reportsListContainer">
                            <!-- Reports will be loaded here -->
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Report Details Modal -->
        <div class="modal fade" id="reportDetailsModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header bg-warning">
                        <h5 class="modal-title"><i class="fas fa-exclamation-triangle"></i> Report Details</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div id="reportDetailsContent">
                            <div class="text-center py-4">
                                <div class="spinner-border" role="status"></div>
                                <p class="mt-2">Loading report details...</p>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                    </div>
                </div>
            </div>
        </div>

        <%- include('crm/partials/footer') %>
            <script type="text/javascript" src="/default/js/src/mod/videos.js"></script>
            <%- include('crm/partials/closure') %>