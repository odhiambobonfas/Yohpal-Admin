<%- include('crm/partials/header') %>
<%- include('crm/partials/navbar') %>

<div class="container-fluid gx-0 px-0">
    <div class="row gap-0 gx-0">
        <div class="col-md-3"><%- include('crm/partials/sidebar') %></div>
        <div class="col-md-9 mt-2 content-body">
            <div class="shadow-lg bg-light-gray p-2 text-dark d-flex justify-content-between align-items-center mb-3">
                <h4>Video Management</h4>
            </div>

            <div class="content-body gx-0 px-0 h-100">
                <!-- Filter Tabs -->
                <div class="card-header bg-white shadow-sm p-2 mb-3">
                    <div class="btn-group" role="group">
                        <button type="button" class="btn btn-outline-primary filter-btn active" data-filter="all">
                            All Videos
                        </button>
                        <button type="button" class="btn btn-outline-warning filter-btn" data-filter="false">
                            Unflagged
                        </button>
                        <button type="button" class="btn btn-outline-danger filter-btn" data-filter="true">
                            Flagged
                        </button>
                    </div>
                </div>

                <!-- Cards Container -->
                <div class="container-fluid col-12 p-0">
                    <div id="videos" class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-3" style="display:none;">
                        <!-- Cards loaded here -->
                    </div>
                    <div id="loading" class="text-center py-4">
                        <div class="spinner-border" role="status"></div>
                    </div>
                    <div id="empty-state" class="text-center py-5" style="display:none;">
                        <i class="fas fa-video fa-3x text-muted mb-3"></i>
                        <h5>No videos found</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Flag Modal -->
<div class="modal fade" id="flagModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Flag Video</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="flagVideoId">
                <div class="mb-3">
                    <label for="flagReason" class="form-label">Reason for flagging <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="flagReason" rows="3" placeholder="Enter reason for flagging this video..." required></textarea>
                    <div class="invalid-feedback">
                        Please provide a reason for flagging this video.
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="confirmFlag">Flag Video</button>
            </div>
        </div>
    </div>
</div>

<%- include('crm/partials/footer') %>
<script type="text/javascript" src="/default/js/src/mod/videos.js"></script>
<%- include('crm/partials/closure') %>
