<%- include('crm/partials/header') %>

<%- include('crm/partials/navbar') %>

<div class="container-fluid gx-0 px-0 dashboard-container">
    <%- include('crm/partials/sidebar') %>
    <div class="main-content p-1 mt-2">
        <div class="shadow-lg bg-light-gray p-2 text-dark d-flex justify-content-between align-items-center mb-3">
            <h4>Update Role</h4>
            <div class="badge-span d-flex justify-content-center align-items-center">
                RBAC | <span class="badge bg-danger text-light rounded-4">Dashboard</span>
            </div>
        </div>
        <div class="content-body gx-0 px-0">
            <div class="card-body p-2">
                <form class="update-role-form" id="updateRoleForm" action="/roles/update/<%= roleId %>" method="post"
                    enctype="multipart/form-data">
                
                    <div class="mb-3 col-12 gap-1 d-flex align-items-center">
                        <div class="mb-3 col-5">
                            <label for="roleName" class="form-label">Role Name</label>
                            <input type="text" id="roleName" name="roleName" class="form-control" required
                                value="<%= role.name %>"
                                placeholder="Enter your custom role to update...">
                        </div>
                        <div class="mb-3 col-4">
                            <label for="code" class="form-label">Role Code</label>
                            <input type="text" id="code" name="code" class="form-control" required
                                value="<%= role.code %>"
                                placeholder="Enter your custom unique role code...">
                        </div>
                        <div class="mb-3 col-3">
                            <label for="status" class="form-label">Role Status</label>
                            <select class="form-control" name="status" id="status">
                                <option value="">-- Select status --</option>
                                <option value="active" <%= role.status === 'active' ? 'selected' : '' %>>Active</option>
                                <option value="inactive" <%= role.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
                            </select>
                        </div>
                    </div>
                
                    <div class="mb-3 col-12 d-flex align-items-center">
                        <div class="form-group col-12">
                            <label for="targets">Target Applications/Modules</label>
                            <select multiple class="form-control searchSelect" name="targets" id="targets">
                                <option value="">-- Select target apps --</option>
                                <option value="admin" <%= role.target.includes('admin') ? 'selected' : '' %>>Yohpal Admin App</option>
                                <option value="market" <%= role.target.includes('market') ? 'selected' : '' %>>Market Application</option>
                                <option value="hustle" <%= role.target.includes('hustle') ? 'selected' : '' %>>Hustle Application</option>
                            </select>
                        </div>
                    </div>
                
                    <div class="mb-3 col-3 d-flex gap-1 justify-content-between align-items-center">
                        <div class="form-check form-check-inline">
                            <label class="form-check-label">
                                <input class="form-check-input isSuperAdmin" type="checkbox" name="isSuperAdmin" id="isSuperAdmin"
                                    value="1" <%= role.isSuperAdmin ? 'checked' : '' %>> Is Super Admin
                            </label>
                        </div>
                        <div class="form-check form-check-inline">
                            <label class="form-check-label">
                                <input class="form-check-input isAdmin" type="checkbox" name="isAdmin" id="isAdmin"
                                    value="1" <%= role.isAdmin ? 'checked' : '' %>> Is Admin
                            </label>
                        </div>
                    </div>
                
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea name="description" id="description" class="form-control description" rows="6"
                            placeholder="Enter role description here..."><%= role.description %></textarea>
                    </div>
                    
                    <hr>
                    <h5 class="mb-3">Assign Permissions</h5>
                
                    <% for (const [group, permissions] of permission_bindings) { %>
                    <div class="mb-3 border rounded p-3 bg-light">
                        <h6 class="mb-2 text-uppercase text-muted"><%= group.charAt(0).toUpperCase() + group.slice(1) %> Permissions</h6>
                        <div class="row">
                            <% for (const [code, permission] of Object.entries(permissions)) { %> 
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input class="form-check-input" type="checkbox" name="permissions[]"
                                        id="perm_<%= group %>_<%= code %>" value="<%= permission %>"
                                        <%= (role.permissions.includes(permission)) ? 'checked' : '' %>>
                                    <label class="form-check-label" for="perm_<%= group %>_<%= code %>">
                                        <%= code.replace(/_/g, ' ').replace(/\b\w/g, c => c.toUpperCase()) %>
                                    </label>
                                </div>
                            </div>
                            <% } %>
                        </div>
                    </div>
                    <% } %> 

                    <div class="form-check form-check-inline">
                        <label class="form-check-label">
                            <input class="form-check-input stayHere" type="checkbox" name="stayHere" id="stayHere"
                                value="1"> Stay here after updating the role.
                        </label>
                    </div>

                    <div class="d-flex justify-content-end mt-4 mb-4">
                        <button type="button" class="btn btn-danger px-4 update-roles-submit-btn" id="updateRolesBtn">
                            <i class="bi bi-plus-circle me-1"></i> Update Role
                        </button>
                    </div>
                </form> 
            </div>
        </div>
    </div>
</div>

<%- include('crm/partials/footer') %>

<script type="text/javascript" src="/default/js/src/mod/roles.js"></script>

<%- include('crm/partials/closure') %>