<%- include('crm/partials/header') %>

<%- include('crm/partials/navbar') %>

<div class="container-fluid gx-0 px-0 dashboard-container">
    <%- include('crm/partials/sidebar') %>
    <div class="main-content p-1 mt-2">
        <div class="shadow-lg bg-light-gray p-2 text-dark d-flex justify-content-between align-items-center mb-3">
            <h4>Roles Management</h4>
            <div class="badge-span d-flex justify-content-center align-items-center">
                RBAC | <span class="badge bg-danger text-light rounded-4">Dashboard</span>
            </div>
        </div>

        <div class="content-body gx-0 px-0">
            <!-- Card Header -->
            <div class="card-header bg-white shadow-sm d-flex justify-content-between align-items-center">
                <button
                    class="btn btn-sm btn-lg btn-link w-100 text-start text-dark d-flex align-items-center gap-3 text-decoration-line-none"
                    type="button" data-bs-toggle="collapse" data-bs-target="#roleFilters" aria-expanded="false"
                    aria-controls="roleFilters">
                    <i class="fas fa-filter fa-2x"></i> <span>Toggle Filters</span>
                </button>
                <a type="button" href="/role/create" class="btn btn-sm btn-danger create-role flex-nowrap text-nowrap" id="createRole">
                    <i class="fa fa-plus-circle" aria-hidden="true"></i> Create Role
                </a>
            </div>

            <!-- Collapsible Filters Section -->
            <div class="container-fluid col-12 collapse mb-3 rolesFilters shadow-sm" id="roleFilters">
                <div class="card-body d-flex gap-1 align-items-center m-1 roles-filters">
                    <div class="col-md-4 mb-2">
                        <label for="role_name">Role Name</label>
                        <input type="text" name="role_name" class="form-control role_name"
                            placeholder="Search by role name...">
                    </div>
                    <div class="col-md-4 mb-2">
                        <label for="role_code">Role Code</label>
                        <input type="text" name="role_code" class="form-control role_code"
                            placeholder="Search by role code...">
                    </div>
                    <div class="col-md-4 mb-2">
                        <label for="roleType">Role Type</label>
                        <select name="roleType" class="form-control roleType">
                            <option value="admin">Admin</option>
                            <option value="superadmin">Super Admin</option>
                            <option value="custom">Custom Role</option>
                        </select>
                    </div>
                </div>
            </div>

            <hr>

            <div class="container-fluid col-12 p-0">
                <div class="table-responsive m-1">
                    <table class="table roles-table" id="roles-table">
                        <thead>
                            <tr>
                                <th>Action</th>
                                <th>Name</th>
                                <th>Code</th>
                                <th>status</th>
                                <th>Added By</th>
                                <th>Description</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td><button type="button" class="btn btn-secondary btn-xs">Action</button></td>
                                <td>Accountant</td>
                                <td>R0001</td>
                                <td>Active</td>
                                <td>Ernest Musau</td>
                                <td>Role mean't for Yohpal Hustle Application</td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('crm/partials/footer') %>

<script type="text/javascript" src="/default/js/src/mod/roles.js"></script>

<%- include('crm/partials/closure') %>