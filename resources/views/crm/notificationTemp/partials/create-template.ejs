<!-- Create Notification Template Modal -->
<div class="modal fade" id="createTemplateModal" tabindex="-1" aria-labelledby="createTemplateModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <form id="createTemplateForm" action="/notification/template/create" method="POST" enctype="multipart/form-data">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title" id="createTemplateModalLabel">
                        <i class="fas fa-plus-circle me-2"></i> Create Notification Template
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"
                        aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="row g-3">
                        <!-- Template Name -->
                        <div class="col-md-6">
                            <label for="templateName" class="form-label">Template Name</label>
                            <input type="text" class="form-control" id="templateName" name="templateName"
                                placeholder="Enter template name" required>
                        </div>

                        <!-- Template Slug -->
                        <div class="col-md-6">
                            <label for="templateCode" class="form-label">Template Code</label>
                            <input type="text" class="form-control" id="templateCode" name="templateCode"
                                placeholder="Unique identifier Code" required>
                        </div>

                        <!-- Channel -->
                        <div class="col-md-6">
                            <label for="templateChannel" class="form-label">Channel</label>
                            <select class="form-control" id="templateChannel" name="templateChannel" required>
                                <option value="">Select channel</option>
                                <option value="email">Email</option>
                                <option value="sms">SMS</option>
                                <option value="whatsapp">WhatsApp</option>
                            </select>
                        </div>

                        <!-- Category -->
                        <div class="col-md-6">
                            <label for="templateCategory" class="form-label">Category</label>
                            <select class="form-control searchSelect" id="_templateCategory" name="templateCategory">
                                <option value="">Select category</option>
                                <%- templateCategoriesForDropdown %>
                            </select>
                        </div>

                        <!-- Status -->
                        <div class="col-md-6">
                            <label for="templateStatus" class="form-label">Status</label>
                            <select class="form-control" id="templateStatus" name="templateStatus" required>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>

                        <!-- Description -->
                        <div class="col-12 position-relative">
                            <label for="templateDescription" class="form-label">Description / Content</label>
                            <p>
                                <a href="#" class="text-dark tdl-0" data-bs-toggle="modal"
                                    data-bs-target="#keywordsHelpModal">
                                    <span class="instructions-modal-btn">To read defined notification template
                                        Instructions(Keywords): click here:</span><i
                                        class="fas fa-info-circle ms-1 text-danger"></i>
                                </a>
                            </p>
                            <textarea class="form-control" id="templateDescription" name="templateDescription" rows="5"
                                placeholder="Template content..."></textarea>
                        </div>

                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light btn-sm text-dark" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger btn-sm create-notification-template-submit-btn">
                        <i class="fas fa-save me-1"></i> Save Template
                    </button>
                </div>
            </div>
        </form>
    </div>
</div>

<%- include('partials/ct-tooltip') %>