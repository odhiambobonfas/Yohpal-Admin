<!-- Keywords Help Sub-Modal -->
<div class="modal fade" id="keywordsHelpModal" tabindex="-1" aria-labelledby="keywordsHelpModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="keywordsHelpModalLabel">
                    <i class="fas fa-info-circle me-2"></i> Predefined Keywords
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>
                    Use the following keywords in your template content. They will be automatically replaced with real values when sending notifications. However, 
                    for sms templates, All documents, image & video related resources like business logo will be ignored:
                </p>
                <p>
                    <%- templateInstructionsForDropdown %>
                </p>

                <% templateInstructionData.forEach(cat => { %>
                    <div class="binding-category <%= !cat.active ? 'd-none' : '' %>" data-category="<%= cat.categorySlug %>">
                        <h4 class="category-title"><%= cat.tabName %></h4>

                        <ul>
                            <% cat.bindings.forEach(b => { %>
                                <li>
                                    <strong><%= b.name %></strong><br>
                                    <code><%= b.slug %></code><br>
                                    <small><%= b.description %></small>
                                </li>
                            <% }) %>
                        </ul>

                    </div>
                <% }) %>
                <p class="text-muted mt-2">Add any of these keywords in the template content to personalize notifications automatically.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>