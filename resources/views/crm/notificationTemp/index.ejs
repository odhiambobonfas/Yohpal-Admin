<%- include('crm/partials/header') %>
<%- include('crm/partials/navbar') %>

<div class="container-fluid gx-0 px-0">
    <div class="row gx-0">
        <!-- Sidebar -->
        <div class="col-md-3">
            <%- include('crm/partials/sidebar') %>
        </div>

        <!-- Main Content -->
        <div class="col-md-9 mt-2 content-body">
            <!-- Page Header -->
            <div class="shadow-lg bg-light-gray p-2 text-dark d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0 d-flex align-items-center gap-2">
                    <i class="fas fa-envelope"></i> Notification Templates
                </h4>
                <div class="badge-span d-flex align-items-center gap-2">
                    <a class="text-decoration-none text-dark" href="/">
                        <i class="fa fa-home me-1"></i> Dashboard
                    </a>
                    <span>|</span>
                    <a href="javascript:void(0)" class="text-decoration-none" data-bs-toggle="modal" data-bs-target="#createTemplateModal">
                        <span class="badge bg-danger text-light rounded-4">
                            <i class="fa fa-plus-circle me-1"></i> Add Template
                        </span>
                    </a>
                </div>
            </div>
            
            <!-- Filters + Table -->
            <div class="content-body gx-0 px-0 h-100">

                <!-- Card Header / Filter Toggle -->
                <div class="card-header bg-white shadow-sm d-flex justify-content-between align-items-center p-1">
                    <button
                        class="btn btn-sm btn-lg btn-link w-100 text-start text-dark d-flex align-items-center gap-3 text-decoration-none"
                        type="button" data-bs-toggle="collapse" data-bs-target="#templateFilters"
                        aria-expanded="false" aria-controls="templateFilters">
                        <i class="fas fa-filter fa-2x"></i> <span>Toggle Filters</span>
                    </button>
                </div>

                <!-- Collapsible Filters Section -->
                <div class="container-fluid col-12 collapse mb-3 templateFilters shadow-sm" id="templateFilters">
                    <div class="col-12 mt-3 row g-3">
                        <div class="col-md-4 mb-2">
                            <label for="templateName">Template Name</label>
                            <input type="text" name="templateName" class="form-control templateName"
                                placeholder="Search by template name...">
                        </div>

                        <div class="col-md-4 mb-2">
                            <label for="channel">Channel</label>
                            <select name="channel" class="form-control channel searchSelect">
                                <option value="">All</option>
                                <option value="email">Email</option>
                                <option value="sms">SMS</option>
                                <option value="whatsapp">WhatsApp</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-2">
                            <label for="status">Status</label>
                            <select name="status" class="form-control status searchSelect">
                                <option value="">All</option>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>

                        <div class="col-md-4 mb-2">
                            <label for="createdRange">Created Range</label>
                            <input type="text" name="createdRange" id="daterange" class="form-control daterange createdRange">
                        </div>

                        <div class="col-md-4 mb-2">
                            <label for="tempCategory">Category</label>
                            <select name="tempCategory" class="form-control tempCategory searchSelect">
                                <option value="">All</option>
                                <%- templateCategoriesForDropdown %>
                            </select>
                        </div>
                    </div>
                </div>

                <hr>

                <!-- Table Section -->
                <div class="container-fluid col-12 p-0">
                    <div class="table-responsive m-1">
                        <table class="table table-striped w-100 notification-templates-table" id="notification-templates-table">
                            <thead class="table-light">
                                <tr>
                                    <th>Action</th>
                                    <th>Name</th>
                                    <th>Subject</th>
                                    <th>Channel</th>
                                    <th>Server Email</th>
                                    <th>Category</th>
                                    <th>Status</th>
                                    <th>Created At</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Dynamic content -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- modals -->
<%- include('notificationTemp/partials/create-template') %>
<div class="modal fade notificationTemplateViewModal" id="modalId" tabindex="-1" role="dialog" aria-labelledby="modalTitleId" aria-hidden="true"></div>
<div class="modal fade editTemplateModal" id="editTemplateModal" tabindex="-1" role="dialog" aria-labelledby="modalTitleId" aria-hidden="true"></div>
<!-- /modals -->

<%- include('crm/partials/footer') %>
<script type="text/javascript" src="/default/js/src/mod/templates.js"></script>
<script src="https://cdn.tiny.cloud/1/<%= tinyMceApiSettings?.settings?.apiKey %>/tinymce/6/tinymce.min.js" referrerpolicy="origin"></script>
<%- include('crm/partials/closure') %> 
