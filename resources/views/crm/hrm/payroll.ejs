<%- include('crm/partials/header') %>
<%- include('crm/partials/navbar') %>

<div class="container-fluid gx-0 px-0">
    <div class="row gap-0 gx-0">
        <div class="col-md-3">
            <%- include('crm/partials/sidebar') %>
        </div>

        <div class="col-md-9 mt-2 content-body">
            <!-- Header -->
            <div class="shadow-lg bg-light-gray p-2 text-dark d-flex justify-content-between align-items-center mb-3">
                <h4>Payroll Management</h4>
                <div class="badge-span d-flex justify-content-center align-items-center gap-2">
                    <a class="text-decoration-line-none text-dark" href="/">Dashboard</a> 
                    <span>|</span>
                    <a href="/payroll/create" class="text-decoration-line-none">
                        <span class="badge bg-danger text-light rounded-4">Create Payroll</span>
                    </a>
                </div>
            </div>

            <!-- Nav Tabs -->
            <ul class="nav nav-tabs mb-3 m-1 border-4 shadow-lg justify-content-between align-items-center" id="paymentTabs" role="tablist">
                <li class="nav-item col-md-3" role="presentation">
                    <button class="nav-link text-dark active w-100" id="components-tab" data-bs-toggle="tab" data-bs-target="#components" type="button" role="tab" aria-controls="earnings" aria-selected="false">
                        <i class="fa fa-coins me-2 text-success"></i> Components Management
                    </button>
                </li>

                <li class="nav-item col-md-3" role="presentation">
                    <button class="nav-link text-dark w-100" id="brackets-tab" data-bs-toggle="tab" data-bs-target="#brackets" type="button" role="tab" aria-controls="brackets" aria-selected="true">
                        <i class="fa fa-sliders-h me-2 text-dark"></i> Brackets Management
                    </button>
                </li>

                <li class="nav-item col-md-3" role="presentation">
                    <button class="nav-link text-dark w-100" id="tiers-tab" data-bs-toggle="tab" data-bs-target="#tiers" type="button" role="tab" aria-controls="tiers" aria-selected="false">
                        <i class="fa fa-layer-group me-2 text-info"></i> Tiers Management
                    </button>
                </li>

                <li class="nav-item col-md-3" role="presentation">
                    <button class="nav-link text-dark w-100" id="payroll-tab" data-bs-toggle="tab" data-bs-target="#payroll" type="button" role="tab" aria-controls="deductions" aria-selected="false">
                        <i class="fa fa-file-invoice-dollar me-2 text-danger"></i> Payroll Management
                    </button>
                </li>
            </ul>

            <!-- Tab Content -->
            <div class="tab-content payment-content-section shadow-sm rounded-0 bg-light p-2" id="paymentTabsContent"> 
                <!-- Earnings -->
                <div class="tab-pane fade show active components-res" id="components" role="tabpanel" aria-labelledby="components-tab">
                    <%- include('hrm/partials/payroll/payment-components') %>
                </div>
                
                <!-- brackets -->
                <div class="tab-pane fade brackets-res" id="brackets" role="tabpanel" aria-labelledby="brackets-tab">
                    <%- include('hrm/partials/payroll/bracket-components') %>
                </div>

                <!-- tiers -->
                <div class="tab-pane fade tiers-res" id="tiers" role="tabpanel" aria-labelledby="tiers-tab">
                    <%- include('hrm/partials/payroll/tiers-components') %>
                </div>

                <!-- Deductions -->
                <div class="tab-pane fade payroll-res" id="payroll" role="tabpanel" aria-labelledby="payroll-tab">
                    <%- include('hrm/partials/payroll/payroll-panel') %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modals --> 
<%- include('hrm/partials/payroll/create-component') %>
<%- include('hrm/partials/payroll/create-bracket-scope') %>
<%- include('hrm/partials/payroll/create-tier-scope') %>
<!-- /Modals -->

<%- include('crm/partials/footer') %>
<script type="text/javascript" src="/default/js/src/mod/hrm.js"></script>
<script type="text/javascript" src="/default/js/src/mod/payroll.js"></script>
<%- include('crm/partials/closure') %>
