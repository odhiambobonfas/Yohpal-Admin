<%- include('crm/partials/header') %>
<%- include('crm/partials/navbar') %>

<div class="container-fluid gx-0 px-0">
    <div class="row gap-0 gx-0">
        <div class="col-md-3">
            <%- include('crm/partials/sidebar') %>
        </div>

        <div class="col-md-9 mt-2 content-body">
            <!-- Header -->
            <div class="shadow-lg bg-light-gray p-2 text-dark d-flex justify-content-between align-items-center mb-3">
                <h4>Payroll Management</h4>
                <div class="badge-span d-flex justify-content-center align-items-center gap-2">
                    <a class="text-decoration-line-none text-dark" href="/">Dashboard</a> 
                </div>
            </div>

            <!-- Nav Tabs -->
            <ul class="nav nav-tabs mb-3 m-1 border-4 shadow-lg justify-content-between align-items-center" id="paymentTabs" role="tablist"> 
                <li class="nav-item col-md-6" role="presentation">
                    <button class="nav-link active w-100" id="earnings-tab" data-bs-toggle="tab" data-bs-target="#earnings" type="button" role="tab" aria-controls="earnings" aria-selected="false">
                        <i class="fa fa-plus-circle me-2 text-success"></i> Earnings Management
                    </button>
                </li>
                <li class="nav-item col-md-6" role="presentation">
                    <button class="nav-link w-100" id="deductions-tab" data-bs-toggle="tab" data-bs-target="#deductions" type="button" role="tab" aria-controls="deductions" aria-selected="true">
                        <i class="fa fa-minus-circle me-2 text-danger"></i> Deductions Management
                    </button>
                </li> 
            </ul>

            <!-- Tab Content -->
            <div class="tab-content payment-content-section shadow-sm rounded-0 bg-light p-2" id="paymentTabsContent">
                <!-- Earnings -->
                <div class="tab-pane fade show active earnings-res" id="earnings" role="tabpanel" aria-labelledby="earnings-tab">
                    <%- include('hrm/partials/payroll/earning-components') %>
                </div>

                <!-- Deductions -->
                <div class="tab-pane fade deductions-res" id="deductions" role="tabpanel" aria-labelledby="deductions-tab">
                    <%- include('hrm/partials/payroll/deduction-components') %>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<%- include('hrm/partials/create-payment-component') %>
<!-- /Modal -->

<%- include('crm/partials/footer') %>
<script type="text/javascript" src="/default/js/src/mod/hrm.js"></script>
<script type="text/javascript" src="/default/js/src/mod/payroll.js"></script>
<%- include('crm/partials/closure') %>
