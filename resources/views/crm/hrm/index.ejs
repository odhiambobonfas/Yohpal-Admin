<%- include('crm/partials/header') %>
<%- include('crm/partials/navbar') %>

<div class="container-fluid gx-0 px-0">
    <div class="row gap-0 gx-0">
        <div class="col-md-3"><%- include('crm/partials/sidebar') %></div>
        <div class="col-md-9 mt-2 content-body">
            <div class="shadow-lg bg-light-gray p-2 text-dark d-flex justify-content-between align-items-center mb-3">
                <h4>Human Resource Management, HRM</h4>
                <div class="badge-span d-flex justify-content-center align-items-center gap-2">
                    <a class="text-decoration-line-none text-dark" href="/">Dashboard</a>
                    <span>|</span>
                    <a href="/attendance/create" class="text-decoration-line-none">
                        <span class="badge bg-danger text-light rounded-4">Manage Attendance</span>
                    </a>
                </div>
            </div>

            <div class="content-body gx-0 px-0 h-100">
                <div class="container-fluid m-0 p-0 pb-5">
                    <div class="row m-1 mt-3">
                        <div class="col-3 text-start p-5 shadow-sm">
                            <h5 class="stat-count" data-id="total-employees">0</h5>
                            <p>Total Employees</p>
                        </div>
                        <div class="col-3 text-start p-5 shadow-sm">
                            <h5 class="stat-count" data-id="new-hires-this-month">0</h5>
                            <p>New Hires (This Month)</p>
                        </div>
                        <div class="col-3 text-start p-5 shadow-sm">
                            <h5 class="stat-count" data-id="open-positions">0</h5>
                            <p>Open Positions</p>
                        </div>
                        <div class="col-3 text-start p-5 shadow-sm">
                            <h5 class="stat-count" data-id="pending-leave-requests">0</h5>
                            <p>Pending Leave Requests</p>
                        </div>

                        <div class="col-3 text-start p-5 shadow-sm">
                            <h5 class="stat-count" data-id="attendance-rate">0%</h5>
                            <p>Average Attendance Rate</p>
                        </div>
                        <div class="col-3 text-start p-5 shadow-sm">
                            <h5 class="stat-count" data-id="total-departments">0</h5>
                            <p>Total Departments</p>
                        </div>
                        <div class="col-3 text-start p-5 shadow-sm">
                            <h5 class="stat-count" data-id="monthly-payroll-cost">0</h5>
                            <p>Monthly Payroll Cost</p>
                        </div>
                        <div class="col-3 text-start p-5 shadow-sm">
                            <h5 class="stat-count" data-id="performance-reviews-completed">0</h5>
                            <p>Performance Reviews Completed</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include('crm/partials/footer') %>
<script type="text/javascript" src="/default/js/src/mod/users.js"></script>
<%- include('crm/partials/closure') %>
