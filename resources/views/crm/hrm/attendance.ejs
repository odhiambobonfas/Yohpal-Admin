
<%- include('crm/partials/header') %>
<%- include('crm/partials/navbar') %>

<div class="container-fluid gx-0 px-0">
    <div class="row gap-0 gx-0">
        <div class="col-md-3"><%- include('crm/partials/sidebar') %></div>
        <div class="col-md-9 mt-2 content-body">
            <div class="shadow-lg bg-light-gray p-2 text-dark d-flex justify-content-between align-items-center mb-3">
                <h4>Attendances Management</h4>
                <div class="badge-span d-flex justify-content-center align-items-center gap-2">
                    <a class="text-decoration-line-none text-dark" href="/">Dashboard</a>
                    <span>|</span>
                    <a href="/attendances/create" class="text-decoration-line-none" data-bs-toggle="modal" 
                        data-bs-target="#createDeptModal">
                        <span class="badge bg-danger text-light rounded-4">Create Attendances</span>
                    </a>
                </div>
            </div>

            <div class="content-body gx-0 px-0 h-100">
                <!-- Card Header -->
                <div class="card-header bg-white shadow-sm d-flex justify-content-between align-items-center p-1">
                    <button
                        class="btn btn-sm btn-lg btn-link w-100 text-start text-dark d-flex align-items-center gap-3 text-decoration-line-none"
                        type="button" data-bs-toggle="collapse" data-bs-target="#attendanceFilters" aria-expanded="false"
                        aria-controls="attendanceFilters">
                        <i class="fas fa-filter fa-2x"></i> <span>Toggle Filters</span>
                    </button> 
                </div>

                <!-- Collapsible Filters Section -->
                <div class="container-fluid col-12 collapse mb-3 attendancesFilters shadow-sm attendances-filters" id="attendanceFilters">
                    <div class="col-12 mt-3 row g-3">
                        <div class="col-md-4 mb-2">
                            <label class="mb-2" for="attendanceName">Attendance Name</label>
                            <input type="text" name="attendanceName" class="form-control attendanceName"
                                placeholder="Search by attendance name...">
                        </div>

                        <div class="col-md-4 mb-2">
                            <label class="mb-2" for="attendanceCode">Attendance Code</label>
                            <input type="text" name="attendanceCode" class="form-control attendanceCode"
                                placeholder="Search by Code...">
                        </div>   

                        <div class="col-md-4 mb-2">
                            <label class="mb-2" for="createdAt">Create Range</label>
                            <input type="text" name="createdAt" id="daterange" class="form-control daterange createdAt">
                        </div> 
                    </div>
                </div>

                <hr>

                <!-- Table -->
                <div class="container-fluid col-12 p-0">
                    <div class="table-responsive m-1">
                        <table class="table attendances-table" id="attendances-table">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Name</th>
                                    <th>Code</th>
                                    <th>Description</th>    
                                </tr>
                            </thead>
                            <tbody>
                                <!-- dynamic content -->
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- modals -->
<%- include('hrm/partials/create-attendance') %>
<!-- /modals -->

<%- include('crm/partials/footer') %>
<script type="text/javascript" src="/default/js/src/mod/attendance.js"></script>
<%- include('crm/partials/closure') %>
