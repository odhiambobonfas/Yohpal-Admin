<!-- Create Email Setting Modal -->
<div class="modal fade W-75" id="createEmailSettingModal" tabindex="-1" aria-labelledby="createEmailSettingModalLabel"
    aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg w-75">
        <form id="createEmailSettingForm" action="/emails/create" method="POST" enctype="multipart/form-data">
            <div class="modal-content">
                <div class="modal-header bg-light">
                    <h5 class="modal-title" id="createEmailSettingModalLabel">
                        <i class="bi bi-envelope-plus"></i> Create Email Setting
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body"> 

                    <div class="row g-3">
                        <div class="col-md-12 mb-3">
                            <label for="emailUsername" class="form-label fw-bold">Email Address:</label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input type="text" class="form-control" id="emailUsername" name="emailUsername" placeholder="e.g. support" required>
                                <span class="input-group-text">@</span>
                                <div class="col-3">
                                    <select class="form-select searchSelect" id="serverSelect" name="serverSelect" required><%- cpanelServersForDropdown %></select>
                                </div>
                            </div>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label for="emailName" class="form-label fw-bold">Email Name:</label>
                            <input type="text" class="form-control" id="emailName" name="emailName"
                                placeholder="e.g. Support Email" required>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="smtpHost" class="form-label fw-bold">SMTP Host:</label>
                            <input type="text" class="form-control" id="smtpHost" name="smtpHost"
                                placeholder="smtp.example.com" required>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="incomingSmtpPort" class="form-label fw-bold">SMTP Port:</label>
                            <input type="number" class="form-control" id="incomingSmtpPort" name="incomingSmtpPort" placeholder="587"
                                required>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="outgoingSmtpPort" class="form-label fw-bold">SMTP Port:</label>
                            <input type="number" class="form-control" id="outgoingSmtpPort" name="outgoingSmtpPort" placeholder="993"
                                required>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="smtpUser" class="form-label fw-bold">SMTP Username:</label>
                            <input type="text" class="form-control" id="smtpUser" name="smtpUser"
                                placeholder="username@example.com" required>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="smtpPassword" class="form-label fw-bold">SMTP Password:</label>
                            <input type="password" class="form-control" id="smtpPassword" name="smtpPassword"
                                placeholder="••••••••" required>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="encryption" class="form-label fw-bold">Encryption Type:</label>
                            <select class="form-select" id="encryption" name="encryption" required>
                                <option value="">Select Encryption</option>
                                <option value="ssl">SSL</option>
                                <option value="tls">TLS</option> 
                            </select>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label for="status" class="form-label fw-bold">Status:</label>
                            <select class="form-select" id="status" name="status" required>
                                <option value="active">Active</option>
                                <option value="inactive">Inactive</option>
                            </select>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label for="shareToEmail" class="form-label fw-bold">Share Settings To (Emails)::</label>
                            <input type="email" class="form-control" id="shareToEmail" name="shareToEmail"
                                placeholder="e.g. support@gmail.com, support@hotmail.com" required>
                        </div>
                        
                        <div class="col-md-6 mb-3">
                            <label for="diskQuota" class="form-label fw-bold">Disk Quota:</label>
                            <select class="form-select diskQuota" id="diskQuota" name="diskQuota" required>
                                <option value="unlimited" selected>Unlimited</option>
                                <option value="limited">Limited</option>
                            </select>
                        </div>

                        <div class="col-md-6 mb-3 quotaValueWrapper d-none" id="quotaValueWrapper">
                            <label for="quotaValue" class="form-label fw-bold">Enter Quota (MB):</label>
                            <input type="number" class="form-control quotaValue" id="quotaValue" name="quotaValue" value="1024">
                        </div>

                        <div class="col-md-12 mb-3">
                            <label class="form-label fw-bold">Suspension Settings:</label>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="suspendIncoming" name="suspendIncoming" value="1">
                                <label class="form-check-label" for="suspendIncoming">Suspend Incoming Emails</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="suspendLogin" name="suspendLogin" value="1">
                                <label class="form-check-label" for="suspendLogin">Suspend Login</label>
                            </div>
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="suspendOutgoing" name="suspendOutgoing" value="1">
                                <label class="form-check-label" for="suspendOutgoing">Suspend Outgoing Emails</label>
                            </div>
                        </div>
                    </div>

                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-light btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-danger btn-sm create-email-address-submit-btn">
                        <i class="bi bi-save"></i> Save Setting
                    </button>
                </div>
            </div>
    </div>
</div>
</div>