<!-- Create Payment Account Category Modal -->
<div class="modal fade createAccountCategoryModal" id="createAccountCategoryModal" tabindex="-1" aria-labelledby="createAccountCategoryModalLabel" aria-hidden="true">
    <form action="/accounts/categories/create" method="post" enctype="multipart/form-data">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg">
                <div class="modal-header bg-light">
                    <h5 class="modal-title fw-bold" id="createAccountCategoryModalLabel">
                        <i class="fa fa-wallet me-2 text-danger"></i> Add Payment Account Category
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <div class="row g-3">
                        <!-- Category Name -->
                        <div class="col-md-6">
                            <label for="accountCategoryName" class="form-label fw-semibold">Category Name <span class="text-danger">*</span></label>
                            <input type="text" name="accountCategoryName" id="accountCategoryName" class="form-control form-control-sm" placeholder="e.g. Bank Accounts, Petty Cash" required>
                        </div>

                        <!-- Account Code -->
                        <div class="col-md-6">
                            <label for="accountCategoryCode" class="form-label fw-semibold">Code</label>
                            <input type="text" name="accountCategoryCode" id="accountCategoryCode" class="form-control form-control-sm" placeholder="e.g. BNK, CSH">
                        </div>

                        <!-- Description -->
                        <div class="col-md-12">
                            <label for="accountCategoryDescription" class="form-label fw-semibold">Description</label>
                            <textarea name="accountCategoryDescription" id="accountCategoryDescription" class="form-control form-control-sm" rows="3" placeholder="Short note about this payment category..."></textarea>
                        </div>
                    </div>
                </div>

                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-secondary btn-sm" data-bs-dismiss="modal">
                        <i class="fa fa-times-circle me-1"></i> Close
                    </button>
                    <button type="submit" class="btn btn-danger btn-sm create-account-category-submit-btn">
                        <i class="fa fa-plus-square me-1"></i> Save Category
                    </button>
                </div>
            </div>
        </div>
    </form>
</div>
