<%- include('crm/partials/header') %> <%- include('crm/partials/navbar') %>

<div class="container-fluid gx-0 px-0">
	<div class="row gap-0 gx-0">
		<div class="col-md-3"><%- include('crm/partials/sidebar') %></div>
		<div class="col-md-9 mt-2 content-body">
			<div class="shadow-lg bg-light-gray p-2 text-dark d-flex justify-content-between align-items-center mb-3">
				<h4>Apps Updates Management</h4>
				<div class="badge-span d-flex justify-content-center align-items-center">
					System Apps |
					<span class="badge bg-danger text-light rounded-4">Dashboard</span>
				</div>
			</div>

			<div class="content-body gx-0 px-0 h-100">
				<!-- Card Header -->
				<div class="card-header bg-white shadow-sm d-flex justify-content-between align-items-center">
					<button
						class="btn btn-sm btn-lg btn-link w-100 text-start text-dark d-flex align-items-center gap-3 text-decoration-line-none"
						type="button" data-bs-toggle="collapse" data-bs-target="#appFilters" aria-expanded="false"
						aria-controls="appFilters">
						<i class="fas fa-filter fa-2x"></i> <span>Toggle Filters</span>
					</button>
					<a type="button" href="/apps/create"
						class="btn btn-sm btn-danger create-app flex-nowrap text-nowrap" id="createApp">
						<i class="fa fa-plus-circle" aria-hidden="true"></i> Create App
					</a>
				</div>

				<!-- Collapsible Filters Section -->
				<div class="container-fluid col-12 collapse mb-3 appsFilters shadow-sm" id="appsFilters">
					<div class="card-body d-flex gap-1 align-items-center m-1 apps-filters">
						<div class="col-md-4 mb-2">
							<label for="app_name">App Name</label>
							<input type="text" name="app_name" class="form-control app_name"
								placeholder="Search by app name..." />
						</div>
						<div class="col-md-4 mb-2">
							<label for="app_code">App Code</label>
							<input type="text" name="app_code" class="form-control app_code"
								placeholder="Search by app code..." />
						</div>
						<div class="col-md-4 mb-2">
							<label for="app_version">App Code</label>
							<input type="text" name="app_version" class="form-control app_version"
								placeholder="Search by app code..." />
						</div>
						<div class="col-md-3 mb-2">
							<label for="appStatus">App Status</label>
							<select name="appStatus" class="form-control appStatus">
								<option value="active">Active</option>
								<option value="deprecated">Deprecated</option>
							</select>
						</div>
						<div class="col-md-3 mb-2">
							<label for="appName">App Name</label>
							<select name="appName" class="form-control appName">
								<option value="app">Yohpal App</option>
								<option value="market">Yohpal Market</option>
								<option value="hustle">Yohpal Hustle</option>
								<option value="chat">Yohpal Chat</option>
							</select>
						</div>
					</div>
				</div>

				<hr />

				<div class="container-fluid col-12 p-0">
					<div class="table-responsive m-1">
						<table class="table apps-table" id="apps-table">
							<thead>
								<tr>
									<th>Action</th>
									<th>Name</th>
									<th>Code</th>
									<th>Version</th>
									<th>Target</th>
									<th>status</th>
									<th>Added By</th>
									<th>Description</th>
								</tr>
							</thead>
							<tbody>
								<!-- content sits in here for display -->
							</tbody>
						</table>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<%- include('crm/partials/footer') %>

<script type="text/javascript" src="/default/js/src/mod/apps.js"></script>

<%- include('crm/partials/closure') %>