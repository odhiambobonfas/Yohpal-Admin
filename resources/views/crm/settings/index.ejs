<%- include('crm/partials/header') %> 
<%- include('crm/partials/navbar') %>

<div class="container-fluid gx-0 px-0">
	<div class="row gap-0 gx-0">
		<div class="col-md-3"><%- include('crm/partials/sidebar') %></div>
		<div class="col-md-9 mt-2 content-body">
		<div
			class="shadow-lg bg-light-gray p-2 text-dark d-flex justify-content-between align-items-center mb-1"
		>
			<h4>Settings</h4>
			<div
			class="badge-span d-flex justify-content-center align-items-center"
			>
			Settings Panel |
			<span class="badge bg-danger text-light rounded-4">Dashboard</span>
			</div>
		</div>
		<div class="content-body gx-0 px-0">
			<div class="card-body p-2"> 
				<div class="row mb-3">
					<div class="form-group"> 
					  <select class="form-control searchSelect" name="searchSettings" id="searchSettings" placeholder="Enter To Search...">
							<option>Business settings</option> 
							<option>API settings</option> 
							<option>HRM settings</option> 
							<option>SMS settings</option> 
							<option>Templating settings</option> 
							<option>Payment settings</option> 
							<option>Notifications settings</option> 
					  </select>
					</div>
				</div>
				<div class="content-section">
					<div class="row">
					  <div class="col-3">
						<div class="card">
						  <div class="card-body">
							<ul class="list-group ulg">
								<li class="list-group-item active">General Settings</li>
								<li class="list-group-item">Tax Settings</li>
								<li class="list-group-item">Transactions</li>
								<li class="list-group-item">Payments</li>
								<li class="list-group-item">HRM Settings</li>
								<li class="list-group-item">API Settings</li>
								<li class="list-group-item">Sms Settings</li> 
								<li class="list-group-item">Template Settings</li>
								<li class="list-group-item">Privacy Settings</li>
								<li class="list-group-item">Website Settings</li>
								<li class="list-group-item">Notifications</li>
							</ul>
							
						  </div>
						</div>
					  </div>
					  <div class="col-9">
						<div class="card">
						  <div class="card-body">
							<h3 class="card-title">Title</h3>
							<p class="card-text">Text</p>
						  </div>
						</div>
					  </div>
					</div>
				</div>
			</div>
		</div>
		</div>
	</div>
</div>

<%- include('crm/partials/footer') %>

<script type="text/javascript" src="/default/js/src/mod/settings.js"></script>

<%- include('crm/partials/closure') %>
