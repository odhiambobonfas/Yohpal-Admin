<%- include('crm/partials/header') %>
<%- include('crm/partials/navbar') %>

<div class="container-fluid gx-0 px-0">
	<div class="row gap-0 gx-0">
		<div class="col-md-3 z-index-3"><%- include('crm/partials/sidebar') %></div>
		<div class="col-md-9 mt-2 content-body">
			<div class="shadow-lg bg-light-gray p-2 text-dark d-flex justify-content-between align-items-center mb-1">
				<h4>Settings</h4>
				<div class="badge-span d-flex justify-content-center align-items-center">
					Settings Panel |
					<span class="badge bg-danger text-light rounded-4 ms-1">Dashboard</span>
				</div>
			</div>
			<div class="content-body gx-0 px-0">
				<div class="card-body p-2 z-index-1">
					<div class="row mb-3">
						<div class="form-group">
							<select class="form-control searchSelect" name="searchSettings" id="searchSettings"
								placeholder="Enter To Search...">
								<option>Business settings</option>
								<option>API settings</option>
								<option>HRM settings</option>
								<option>SMS settings</option>
								<option>Templating settings</option>
								<option>Payment settings</option>
								<option>Notifications settings</option>
							</select>
						</div>
					</div>
					<div class="content-section">
						<div class="row">
							<div class="col-3">
								<div class="card">
									<div class="card-body">
										<ul class="list-group ulg">
											<li class="list-group-item active" data-id="general">General Settings</li>
											<li class="list-group-item" data-id="tax">Tax Settings</li>
											<li class="list-group-item" data-id="transactions">Transactions</li>
											<li class="list-group-item" data-id="payments">Payments</li>
											<li class="list-group-item" data-id="hrm">HRM Settings</li>
											<li class="list-group-item" data-id="api">API Settings</li>
											<li class="list-group-item" data-id="cdn">CDN Settings</li>
											<li class="list-group-item" data-id="sms">Sms Settings</li>
											<li class="list-group-item" data-id="template">Template Settings</li>
											<li class="list-group-item" data-id="privacy">Privacy Settings</li>
											<li class="list-group-item" data-id="website">Website Settings</li>
											<li class="list-group-item" data-id="notifications">Notifications</li>
										</ul>
									</div>
								</div>
							</div>

							<div class="col-9">
								<div class="card">
									<div class="card-body">
										<div class="content" id="general">
											<%- include('settings/partials/create-general-settings') %>
										</div>
										<div class="content d-none" id="tax">Tax Settings Content</div>
										<div class="content d-none" id="transactions">Transactions Content</div>
										<div class="content d-none" id="payments">Payments Content</div>
										<div class="content d-none" id="hrm">HRM Settings Content</div>
										<div class="content d-none" id="api">
											<%- include('settings/partials/api-settings') %>
										</div>
										<div class="content d-none" id="cdn">
											<%- include('settings/partials/cdn-settings') %>
										</div>
										<div class="content d-none" id="sms">Sms Settings Content</div>
										<div class="content d-none" id="template">Template Settings Content</div>
										<div class="content d-none" id="privacy">Privacy Settings Content</div>
										<div class="content d-none" id="website">Website Settings Content</div>
										<div class="content d-none" id="notifications">Notifications Content</div>
									</div>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<!-- modal  -->
<%- include('partials/create-api-setting') %>
<div class="modal fade editApiSettingModal" id="editApiSettingModal" tabindex="-1" aria-labelledby="editApiSettingModalLabel" aria-hidden="true"></div>

<%- include('partials/create-cdn-setting') %>
<div class="modal fade editCdnSettingModal" id="editCdnSettingModal" tabindex="-1" aria-labelledby="editCdnSettingModalLabel" aria-hidden="true"></div>

<div class="modal fade registerApiCallbackModal" id="registerApiCallbackModal" tabindex="-1" aria-labelledby="registerApiCallbackModalLabel" aria-hidden="true"></div>
<!-- /modal  -->

<%- include('crm/partials/footer') %>

<script type="text/javascript" src="/default/js/src/mod/settings.js"></script>

<%- include('crm/partials/closure') %>