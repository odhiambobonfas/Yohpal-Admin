<!-- Edit CDN Setting Modal -->
<div class="modal-dialog modal-lg">
    <form id="editCdnSettingForm" 
          action="/settings/cdn/edit/<%= setting?.id %>" 
          method="POST" 
          enctype="multipart/form-data" 
          class="modal-content">
          
        <div class="modal-header">
            <h5 class="modal-title" id="editCdnSettingModalLabel">Update CDN Setting</h5>
            <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
        </div>

        <div class="modal-body">
            <div class="row g-3"> 
                <div class="col-md-6">
                    <label for="code" class="form-label">Code Identifier (UNIQUE)</label>
                    <input type="text" 
                           class="form-control" 
                           id="code" 
                           name="code" 
                           value="<%= setting?.code %>" 
                           placeholder="e.g. YPCDN0001">
                </div>

                <div class="col-md-6">
                    <label for="cdnProvider" class="form-label">Provider</label>
                    <input type="text" 
                           class="form-control" 
                           id="cdnProvider" 
                           name="cdnProvider" 
                           value="<%= setting?.provider %>" 
                           placeholder="e.g. Cloudflare, AWS CloudFront">
                </div>

                <div class="col-md-6">
                    <label for="cdnUrl" class="form-label">Base URL</label>
                    <input type="url" 
                           class="form-control" 
                           id="cdnUrl" 
                           name="cdnUrl" 
                           value="<%= setting?.baseUrl %>" 
                           placeholder="https://cdn.yohpal.com">
                </div>

                <div class="col-md-6">
                    <label for="cdnZoneId" class="form-label">Zone / Distribution ID</label>
                    <input type="text" 
                           class="form-control" 
                           id="cdnZoneId" 
                           name="cdnZoneId" 
                           value="<%= setting?.zoneId %>" 
                           placeholder="Enter Zone or Distribution ID">
                </div>

                <div class="col-md-6">
                    <label for="cacheDuration" class="form-label">Cache Duration (hours)</label>
                    <input type="number" 
                           class="form-control" 
                           id="cacheDuration" 
                           name="cacheDuration" 
                           value="<%= setting?.cacheDuration %>" 
                           placeholder="e.g. 24">
                </div>

                <div class="col-md-6">
                    <label for="cdnStatus" class="form-label">Status</label>
                    <select class="form-select" id="cdnStatus" name="cdnStatus">
                        <option value="enabled" <%= setting?.status === 'enabled' ? 'selected' : '' %>>Enabled</option>
                        <option value="disabled" <%= setting?.status === 'disabled' ? 'selected' : '' %>>Disabled</option>
                    </select>
                </div>

                <div class="col-md-6">
                    <label for="cdnModule" class="form-label">Module</label>
                    <input type="text" 
                           class="form-control" 
                           id="cdnModule" 
                           name="cdnModule" 
                           value="<%= setting?.module %>" 
                           placeholder="e.g. Storage, Assets">
                </div>

                <div class="col-md-6 mb-3">
                    <label for="targetApp" class="form-label">Target App</label>
                    <select id="targetApp" name="targetApp" class="form-control searchSelect" required>
                        <option value="" disabled>-- Select App --</option>
                        <% applications?.forEach(application => { %>
                            <option value="<%= application.slug %>" 
                                <%= setting?.targetApp === application.slug ? 'selected' : '' %>>
                                <%= application.name %>
                            </option>
                        <% }) %>
                    </select>
                </div> 
            </div>
        </div>

        <div class="modal-footer">
            <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
            <button type="button" class="btn btn-sm btn-danger edit-cdn-setting-submit-btn" id="editSubmitBtn"><i class="fa fa-pencil-square" aria-hidden="true"></i> Save Setting</button>
        </div>
    </form>
</div>
