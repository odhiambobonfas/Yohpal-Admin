<div class="d-flex justify-content-between align-items-center mb-3">
	<h5 class="mb-0">CPanel Settings</h5>
	<button type="button" class="btn btn-danger btn-xs" data-bs-toggle="modal" data-bs-target="#createCpanelSettingModal">
		<i class="bi bi-plus-lg"></i> Add Setting
	</button>
</div>

<div class="table-responsive">
	<table class="table table-bordered table-striped cpanel-settings-table" id="cpanel-settings-table">
		<thead class="table-light">
			<tr>
				<th>Actions</th>
				<th>Host</th>
				<th>Username</th>
				<th>API Token</th>
				<th>Linked Domain</th>
				<th>Status</th>
			</tr>
		</thead>
		<tbody>
			<!-- CPanel content sits in here! -->
		</tbody>
	</table>
</div>