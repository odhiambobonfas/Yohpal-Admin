<!-- Create CDN Setting Modal -->
<div class="modal fade" id="createCdnSettingModal" tabindex="-1" aria-labelledby="createCdnSettingModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <form id="createCdnSettingForm" action="/settings/cdn/create" method="POST" enctype="multipart/form-data" class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="createCdnSettingModalLabel">Add CDN Setting</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label for="code" class="form-label">Code Identifier(UNIQUE)</label>
                        <input type="text" class="form-control" id="code" name="code" placeholder="e.g. YPCDN0001">
                    </div>
                    <div class="col-md-6">
                        <label for="cdnProvider" class="form-label">Provider</label>
                        <input type="text" class="form-control" id="cdnProvider" name="cdnProvider" placeholder="e.g. Cloudflare, AWS CloudFront">
                    </div>
                    <div class="col-md-6">
                        <label for="cdnUrl" class="form-label">Base URL</label>
                        <input type="url" class="form-control" id="cdnUrl" name="cdnUrl" placeholder="https://cdn.yohpal.com">
                    </div>
                    <div class="col-md-6">
                        <label for="cdnZoneId" class="form-label">Zone / Distribution ID</label>
                        <input type="text" class="form-control" id="cdnZoneId" name="cdnZoneId" placeholder="Enter Zone or Distribution ID">
                    </div>
                    <div class="col-md-6">
                        <label for="cacheDuration" class="form-label">Cache Duration (hours)</label>
                        <input type="number" class="form-control" id="cacheDuration" name="cacheDuration" placeholder="e.g. 24">
                    </div>
                    <div class="col-md-6">
                        <label for="cdnStatus" class="form-label">Status</label>
                        <select class="form-select" id="cdnStatus" name="cdnStatus">
                            <option value="enabled">Enabled</option>
                            <option value="disabled">Disabled</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label for="cdnModule" class="form-label">Module</label>
                        <input type="text" class="form-control" id="cdnModule" name="cdnModule" placeholder="e.g. Storage, Assets">
                    </div> 
                    <div class="col-md-6 mb-3">
                        <label for="targetApp" class="form-label">Target App</label>
                        <select id="targetApp" name="targetApp" class="form-control searchSelect" required>
                            <option value="" disabled selected>-- Select App --</option>
                                <% applications?.forEach(application => { %>
                                    <option value="<%= application.slug %>"><%= application.name %></option>
                                <% }) %>
                        </select>
                    </div> 
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-danger create-cdn-setting-submit-btn" id="createSubmitBtn"><i class="fa fa-plus-square" aria-hidden="true"></i> Update Setting</button>
            </div>
        </form>
    </div>
</div>