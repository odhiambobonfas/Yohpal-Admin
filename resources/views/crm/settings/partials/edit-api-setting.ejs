<div class="modal-dialog modal-lg">
  <div class="modal-content">
    <form
      id="apisetting"
      class="edit-api-setting-form"
      action="/api/settings/edit/<%= setting?.id %>"
      enctype="multipart/form-data"
      method="POST"
    >
      <div class="modal-header">
        <h5 class="modal-title" id="editApiSettingModalLabel">
          Edit API Setting
        </h5>
        <button
          type="button"
          class="btn-close"
          data-bs-dismiss="modal"
          aria-label="Close"
        ></button>
      </div>

      <div class="modal-body">
        <!-- General Info -->
        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="provider" class="form-label">Provider</label>
            <select id="provider" name="provider" class="form-select" required>
              <option value="">-- Select Provider --</option>
              <option value="mpesa" <%= setting?.provider === 'mpesa' ? 'selected' : '' %>>M-Pesa</option>
              <option value="paypal" <%= setting?.provider === 'paypal' ? 'selected' : '' %>>PayPal</option>
              <option value="custom" <%= setting?.provider === 'custom' ? 'selected' : '' %>>Custom</option>
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label for="code" class="form-label">Unique Code</label>
            <input
              type="text"
              id="code"
              name="code"
              class="form-control"
              value="<%= setting?.code %>"
              required
            />
          </div>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="phone" class="form-label">Phone Number</label>
            <input
              type="text"
              id="phone"
              name="phone"
              class="form-control"
              value="<%= setting?.phone %>"
              required
            />
            <small>Account holder's phone</small>
          </div>

          <div class="col-md-6 mb-3">
            <label for="email" class="form-label">Email</label>
            <input
              type="text"
              id="email"
              name="email"
              class="form-control"
              value="<%= setting?.email %>"
              required
            />
            <small>Account holder's email</small>
          </div>
        </div>

        <!-- Target App -->
        <div class="col-md-12 mb-3">
          <label for="targetApp" class="form-label">Target App</label>
          <select
            id="targetApp"
            name="targetApp"
            class="form-control searchSelect"
            required
          >
            <option value="" disabled>-- Select App --</option>
            <% applications?.forEach(application => { %>
              <option
                value="<%= application.slug %>"
                <%= setting?.targetApp === application.slug ? 'selected' : '' %>>
                <%= application.name %>
              </option>
            <% }) %>
          </select>
        </div>

        <div class="row">
          <div class="col-md-6 mb-3">
            <label for="environ" class="form-label">Environment</label>
            <select
              id="environ"
              name="environ"
              class="form-select"
              required
            >
              <option value="">-- Select Category --</option>
              <option value="sandbox" <%= setting?.environ === 'sandbox' ? 'selected' : '' %>>Sandbox</option>
              <option value="live" <%= setting?.environ === 'live' ? 'selected' : '' %>>Live</option>
            </select>
          </div>

          <div class="col-md-6 mb-3">
            <label for="status" class="form-label">Status</label>
            <select
              id="status"
              name="status"
              class="form-select"
              required
            >
              <option value="active" <%= setting?.status === 'active' ? 'selected' : '' %>>Active</option>
              <option value="inactive" <%= setting?.status === 'inactive' ? 'selected' : '' %>>Inactive</option>
            </select>
          </div>
        </div>

        <!-- M-Pesa Form -->
        <div class="provider-form <%= setting?.provider !== 'mpesa' ? 'd-none' : '' %>" id="mpesa-form">
          <h6 class="mb-2 fw-bold">M-Pesa Settings</h6>
          <hr />
          <div class="row">
            <div class="col-md-6 mb-3">
              <label class="form-label">Application Name</label>
              <input
                type="text"
                class="form-control"
                name="mpesaSetting[applicationName]"
                value="<%= setting?.settings?.applicationName %>"
              />
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label">Consumer Key</label>
              <input
                type="text"
                class="form-control"
                name="mpesaSetting[consumerKey]"
                value="<%= setting?.settings?.consumerKey %>"
              />
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label">Consumer Secret</label>
              <input
                type="text"
                class="form-control"
                name="mpesaSetting[consumerSecret]"
                value="<%= setting?.settings?.consumerSecret %>"
              />
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label">Shortcode</label>
              <input
                type="text"
                class="form-control"
                name="mpesaSetting[shortCode]"
                value="<%= setting?.settings?.shortCode %>"
              />
            </div>

            <div class="col-md-6 mb-3">
              <label class="form-label">Passkey</label>
              <input
                type="text"
                class="form-control"
                name="mpesaSetting[passKey]"
                value="<%= setting?.settings?.passKey %>"
              />
            </div>

            <div class="col-md-6 mb-3">
              <label for="validationParameter" class="form-label"
                >Validation Status</label
              >
              <select
                id="validationParameter"
                name="mpesaSetting[validationParameter]"
                class="form-select"
                required
              >
                <option value="">-- Select Status --</option>
                <option
                  value="completed"
                  <%= setting?.settings?.validationParameter === 'completed' ? 'selected' : '' %>
                >Completed</option>
                <option
                  value="rejected"
                  <%= setting?.settings?.validationParameter === 'rejected' ? 'selected' : '' %>
                >Rejected</option>
              </select>
            </div>

            <div class="col-md-12 mb-3">
              <label class="form-label">Confirmation Callback URL</label>
              <input
                type="url"
                class="form-control"
                name="mpesaSetting[callbackUrl][confirmation]"
                value="<%= setting?.settings?.callbackUrl?.confirmation %>"
              />
            </div>

            <div class="col-md-12 mb-3">
              <label class="form-label">Validation Callback URL</label>
              <input
                type="url"
                class="form-control"
                name="mpesaSetting[callbackUrl][validation]"
                value="<%= setting?.settings?.callbackUrl?.validation %>"
              />
            </div>
          </div>
        </div>

        <div class="form-check form-check-inline">
          <label class="form-check-label">
            <input
              class="form-check-input isDefault"
              type="checkbox"
              name="isDefault"
              id="isDefault"
              value="1"
              <%= setting?.isDefault ? 'checked' : '' %>
            />
            Make this a default API (For the Target Application)
          </label>
        </div>
      </div>

      <div class="modal-footer">
        <button
          type="button"
          class="btn btn-sm btn-light"
          data-bs-dismiss="modal"
        >
          Cancel
        </button>
        <button
          type="button"
          class="btn btn-sm btn-danger edit-setting-submit-btn"
        >
          <i class="fa fa-plus-circle" aria-hidden="true"></i>
          Save Setting
        </button>
      </div>
    </form>
  </div>
</div>
