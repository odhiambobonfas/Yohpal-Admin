<!-- General Settings Form -->
<div class="d-flex justify-content-between align-items-center mb-3">
	<h5 class="mb-0">General Settings - Yohpal Company</h5>
</div>
<div class="container-fluid">
	<form id="generalsettings" action="/api/setting/create" enctype="multipart/form-data" method="POST">
		<!-- Section: Company Info --> 
		<h6 class="mb-3 border-bottom pb-2 fw-bold">Company Information</h6>
		<div class="row mb-3">
			<div class="col-md-6">
				<label for="company_name" class="form-label">Company Name</label>
				<input type="text" class="form-control" id="company_name" name="company_name" 
					value="<%= generalsetting?.companyName || '' %>" placeholder="Enter company name">
			</div>
			<div class="col-md-6">
				<label for="company_website" class="form-label">Website</label>
				<input type="url" class="form-control" id="company_website" name="company_website"
					value="<%= generalsetting?.companyWebsite || '' %>" placeholder="https://yohpal.com">
			</div>
		</div>

		<!-- Section: Contact -->
		<h6 class="mb-3 border-bottom pb-2 fw-bold">Contact Information</h6>
		<div class="row mb-3">
			<div class="col-md-6">
				<label for="company_email" class="form-label">Email</label>
				<input type="email" class="form-control" id="company_email" name="company_email"
					value="<%= generalsetting?.companyEmail || '' %>" placeholder="example@company.com">
			</div>
			<div class="col-md-6">
				<label for="company_phone" class="form-label">Phone</label>
				<input type="tel" class="form-control" id="company_phone" name="company_phone"
					value="<%= generalsetting?.companyPhone || '' %>" placeholder="+254 700 000 000">
			</div>
		</div>
		<div class="row mb-3">
			<div class="col-md-12">
				<label for="company_address" class="form-label">Address</label>
				<textarea class="form-control" id="company_address" name="company_address" rows="2"
					placeholder="Enter company address"><%= generalsetting?.companyAddress || '' %></textarea>
			</div>
		</div>

		<!-- Section: Others -->
		<h6 class="mb-3 border-bottom pb-2 fw-bold">Other Settings</h6>
		<div class="row mb-3">
			<div class="col-md-6">
				<label for="company_industry" class="form-label">Industry</label>
				<input type="text" class="form-control" id="company_industry" name="company_industry"
					value="<%= generalsetting?.companyIndustry || '' %>" placeholder="e.g. Tech, Retail">
			</div>
			<div class="col-md-6">
				<label for="company_registration" class="form-label">Registration No.</label>
				<input type="text" class="form-control" id="company_registration" name="company_registration"
					value="<%= generalsetting?.companyRegistration || '' %>" placeholder="123456">
			</div>
		</div>

		<!-- File Upload Div -->
		<div class="col-12">
			<label for="companyLogo" class="form-label">Company Logo</label>
			<div class="card shadow-sm border-dark p-4 text-center" style="cursor: pointer; min-height: 120px;"
				onclick="document.getElementById('companyLogo').click()">

				<div class="d-flex flex-column justify-content-center align-items-center h-100">
					<% if (generalsetting?.companyLogo) { %>
						<img src="<%= generalsetting.companyLogo %>" alt="Company Logo" class="img-fluid" style="max-height: 80px;">
					<% } else { %>
						<i class="bi bi-file-earmark-arrow-up fs-1 text-muted"></i>
						<span class="text-muted mt-2">Click to upload file</span>
					<% } %>
				</div>

				<!-- Hidden File Input -->
				<input type="file" id="companyLogo" name="companyLogo" class="d-none" accept="image/*">
			</div>
		</div>

		<!-- Save -->
		<div class="d-flex justify-content-end mt-4">
			<button type="submit" class="btn btn-danger setting-submit-btn">Save Settings</button>
		</div>
	</form>
</div>
