<%- include('partials/header') %>

<div class="login-container">
    <div class="d-flex justify-content-center align-items-center mb-3">
        <div class="col-3">
            <img class="brand-logo-img" src="https://hustle.yohpal.com/assets/store/logos/logo_circular.png" alt="Yohpal Logo">
        </div>
    </div> 
    <p class="text-center text-muted">Login in to your account</p> 
    
    <form class="login-user-form" action="/login" method="POST">
        <div class="mb-3">
            <label for="email" class="form-label fw-bold">Email: </label>
            <input type="email" value="<%= test_username %>" name="email" id="email" class="form-control email" placeholder="Enter email" required>
        </div>

        <div class="mb-3">
            <label for="password" class="form-label fw-bold">Password: </label>
            <input type="password" value="<%= test_password %>" name="password" id="password" class="form-control password" placeholder="Enter password" required>
        </div>

        <div class="text-end mb-3">
            <a href="/forgot-password" class="text-decoration-line-none text-danger">Forgot Password?</a>
        </div>

        <div class="d-grid">
            <button type="button" class="btn btn-custom btn-danger login-btn" id="login-btn">Login</button>
        </div>
    </form> 
</div>

<!-- scripts -->
<script src="default/js/src/auth.js?v1"></script>
<!-- /scripts -->

<%- include('partials/footer') %>
