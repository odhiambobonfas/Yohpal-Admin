<%- include('partials/header') %>

<div class="login-container">
    <div class="d-flex justify-content-center align-items-center mb-3">
        <div class="col-3">
            <img class="brand-logo-img" src="https://hustle.yohpal.com/assets/store/logos/logo_circular.png" alt="Yohpal Logo">
        </div>
    </div> 
    <p class="text-center text-muted">Login in to your account</p>

    <% if (message.length > 0) { %>
        <div class="form-group">
            <div class="alert alert-<%= status && status == 'success' ? 'primary' : 'danger' %>" role="alert">
                <strong>Alert:</strong> <%= message %>
            </div>
        </div>
    <% } %>
    
    <form class="login-user-form" action="/login" method="POST" enctype="multipart/form-data">
        <div class="mb-3">
            <label for="email" class="form-label fw-bold">Email: </label>
            <input type="email" value="gicehajunior76@gmail.com" name="email" id="email" class="form-control" placeholder="Enter email" required>
        </div>

        <div class="mb-3">
            <label for="password" class="form-label fw-bold">Password: </label>
            <input type="password" value="giceha@2025" name="password" id="password" class="form-control" placeholder="Enter password" required>
        </div>

        <div class="text-end mb-3">
            <a href="/forgot-password" class="text-decoration-none text-danger">Forgot Password?</a>
        </div>

        <div class="d-grid">
            <button type="button" class="btn btn-custom btn-danger login-btn" id="login-btn">Login</button>
        </div>
    </form> 
</div>

<!-- scripts -->
<script src="default/js/src/auth.js?v1"></script>
<!-- /scripts -->

<%- include('partials/footer') %>
