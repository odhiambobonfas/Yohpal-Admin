{
    "compilerOptions": { 
        "outDir": "./dist",
        "rootDir": "./",
        "strict": false,
        "target": "ES2022",
        "module": "commonjs",
        "allowJs": false,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "baseUrl": "./",
        "typeRoots": ["public/default/types", "node_modules/@types"],
        "paths": {
            "@mex/*": ["mex/*"],
            "@app/*": ["app/*"],
            "@funcs/*": ["app/helpers/*"],
            "@config/*": ["config/*"],
            "@ip/*": ["config/ipsConfig/*"],
            "@lang/*": ["public/default/js/lang/*"],
            "@models/*": ["app/models/*"],
            "@utils/*": ["app/utils/*"],
            "@db/*": ["config/database/*"],
            "@database/*": ["config/database/*"],
            "@services/*": ["mex/services/*"],
            "@controllers/*": ["app/controllers/*"],
            "@routes/*": ["routes/*"]
        },  
    },  
}
